/** Torn Mug Marks Tracker bridge. BSD-3-Clause. Deploy as web app, execute as me. */
const TAB_TARGETS='Mug Marks', TAB_LOG='Mug Log';
function setup(){const ss=SpreadsheetApp.getActive(); const specs={
 'Mug Marks':['Torn ID','Target Name','Level','Job','Property','Net Worth','Pipeline','Days Inactive','Last Seen UTC','Notes','Updated UTC'],
 'Mug Log':['Event ID','Time UTC','Target Torn ID','Target Name','Cash Yield','Outcome','Notes','Source'],
 'Settings':['Setting','Value'],
 'Hunting Guide':['Pipeline','Notes']};
 Object.entries(specs).forEach(([name,head])=>{let s=ss.getSheetByName(name)||ss.insertSheet(name);if(s.getLastRow()===0){s.appendRow(head);s.setFrozenRows(1);s.getRange(1,1,1,head.length).setBackground('#182b3a').setFontColor('#ffffff').setFontWeight('bold');}});
 const settings=ss.getSheetByName('Settings');if(settings.getLastRow()===1){settings.appendRow(['Cooldown estimate (hours)',15]);settings.appendRow(['Timezone','UTC']);settings.appendRow(['Note','Cooldown is an assumption, not verified game behavior']);}
}
function doPost(e){try{const d=JSON.parse(e.postData.contents);const p=PropertiesService.getScriptProperties();const secret=p.getProperty('WRITE_TOKEN');if(!secret||d.token!==secret)throw Error('Unauthorized');const lock=LockService.getScriptLock();lock.waitLock(10000);try{setup();const ss=SpreadsheetApp.getActive();if(d.action==='target'){const id=String(d.id||'');if(!/^\d{1,12}$/.test(id))throw Error('Invalid ID');const sh=ss.getSheetByName(TAB_TARGETS);const data=sh.getDataRange().getValues();let row=data.findIndex((v,i)=>i>0&&String(v[0])===id)+1;const prior=row?data[row-1]:[];const values=[id,String(d.name||prior[1]||'').slice(0,80),Number(d.level||prior[2]||0)||'',String(d.job||prior[3]||'').slice(0,100),String(d.property||prior[4]||'').slice(0,100),Number(d.netWorth||prior[5]||0)||'',String(d.pipeline||prior[6]||'').slice(0,80),Number(d.daysInactive||prior[7]||0)||'',String(d.lastSeen||prior[8]||'').slice(0,60),String(d.notes||prior[9]||'').slice(0,500),new Date().toISOString()];if(row)sh.getRange(row,1,1,values.length).setValues([values]);else sh.appendRow(values);return out({ok:true});}
if(d.action==='mug'){const id=String(d.id||'');const event=String(d.eventId||'');if(!/^\d{1,12}$/.test(id)||!/^[-\w:.]{8,100}$/.test(event))throw Error('Invalid event');const sh=ss.getSheetByName(TAB_LOG);const existing=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,1).getValues().flat():[];if(existing.includes(event))return out({ok:true,duplicate:true});sh.appendRow([event,String(d.time||new Date().toISOString()),id,String(d.name||'').slice(0,80),Math.max(0,Number(d.yield||0)),String(d.outcome||'Unknown').slice(0,40),String(d.notes||'').slice(0,500),'Userscript']);return out({ok:true});}
throw Error('Unknown action');}finally{lock.releaseLock();}}catch(err){return out({ok:false,error:String(err.message||err)});}}
function out(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
